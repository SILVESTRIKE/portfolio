# =============================================================================
# SILVESTRIKE Portfolio OS — Environment Variables Template
# Copy to .env and fill in values. NEVER commit .env to git.
# =============================================================================

# Google Gemini API key for Doru AI assistant
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_KEY=your_gemini_api_key_here

# Secret Master Access Token for Private Recruiter Intelligence Dashboard
# Set a strong, unguessable password. Never commit real values to git.
ADMIN_TOKEN=your_secure_admin_password_here

# Music Telemetry & Streaming Engine (Caelestia / Terminal Music Widget)
# Last.fm API Key & Username (free non-commercial key from https://www.last.fm/api/account/create)
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USERNAME=your_lastfm_username_here

# Google Cloud OAuth 2.0 Credentials for YouTube Data API v3 (Recommended)
GOOGLE_CLIENT_ID=your_oauth_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_REFRESH_TOKEN=1//your_permanent_refresh_token_here

# YouTube Data API v3 Key (alternative fallback if Google OAuth is not configured)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Upstash Redis REST Credentials (free serverless Redis from Vercel Storage or upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Optional Fallback YouTube Video ID (defaults to Black Sabbath - Iron Man: kBVIDGxSKX8)
FALLBACK_MUSIC_VIDEO_ID=kBVIDGxSKX8
